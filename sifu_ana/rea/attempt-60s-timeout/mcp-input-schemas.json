  {
    "name": "open_binary",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/__schema0",
          "description": "Absolute local filesystem path for the analysis target; relative paths are rejected."
        },
        "format": {
          "$ref": "#/$defs/__schema2",
          "description": "Explicit headerless DOS COM interpretation; omission preserves header-based detection"
        },
        "provider_id": {
          "$ref": "#/$defs/__schema4",
          "description": "Exact deep-analysis provider ID, or automatic selection when omitted."
        },
        "snapshot_path": {
          "$ref": "#/$defs/__schema5",
          "description": "Absolute local filesystem path for the analysis snapshot; relative paths are rejected."
        }
      },
      "required": [
        "path"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "$defs": {
        "__schema0": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]*$",
          "description": "Absolute local filesystem path for the analysis target; relative paths are rejected.",
          "$ref": "#/$defs/__schema1"
        },
        "__schema1": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]*$"
        },
        "__schema2": {
          "description": "Explicit headerless DOS COM interpretation; omission preserves header-based detection",
          "$ref": "#/$defs/__schema3"
        },
        "__schema3": {
          "type": "string",
          "const": "dos-com"
        },
        "__schema4": {
          "anyOf": [
            {
              "type": "string",
              "const": "auto"
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9\\x2d]*$"
            }
          ]
        },
        "__schema5": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]*$",
          "description": "Absolute local filesystem path for the analysis snapshot; relative paths are rejected.",
          "$ref": "#/$defs/__schema1"
        }
      },
      "examples": [
        {
          "path": "/tmp/fixture"
        }
      ]
    }
  },
  {
    "name": "close_binary",
    "inputSchema": {
      "type": "object",
      "properties": {
        "snapshot_path": {
          "$ref": "#/$defs/__schema0",
          "description": "Absolute local filesystem path for the analysis snapshot; relative paths are rejected."
        },
        "overwrite": {
          "$ref": "#/$defs/__schema1",
          "description": "Whether an existing destination may be replaced."
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "$defs": {
        "__schema0": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]*$",
          "description": "Absolute local filesystem path for the analysis snapshot; relative paths are rejected."
        },
        "__schema1": {
          "default": false,
          "type": "boolean"
        }
      },
      "examples": [
        {
          "overwrite": false
        }
      ]
    }
  },
  {
    "name": "binary_session",
    "inputSchema": {
      "type": "object",
      "properties": {
        "expected_package_version": {
          "$ref": "#/$defs/__schema0",
          "description": "Expected package version used to reject stale or mismatched input."
        },
        "expected_catalog_digest": {
          "$ref": "#/$defs/__schema1",
          "description": "Expected catalog digest used to reject stale or mismatched input."
        },
        "expected_server_path": {
          "$ref": "#/$defs/__schema2",
          "description": "Absolute local filesystem path expected for the running server; relative paths are rejected."
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "$defs": {
        "__schema0": {
          "type": "string",
          "minLength": 1
        },
        "__schema1": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "__schema2": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00]*$",
          "description": "Absolute local filesystem path expected for the running server; relative paths are rejected."
        }
      },
      "examples": [
        {}
      ]
    }
  }
